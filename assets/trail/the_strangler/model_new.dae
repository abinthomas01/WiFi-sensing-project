  <library_effects>
    <effect id="Std_Tongue-fx" name="Std_Tongue">
      <profile_COMMON>
        <newparam sid="Std_Tongue-diffuse-surface">
          <surface type="2D">
            <init_from>Std_Tongue-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="Std_Tongue-diffuse-sampler">
          <sampler2D>
            <source>Std_Tongue-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <newparam sid="Std_Tongue-normal-surface">
          <surface type="2D">
            <init_from>Std_Tongue-normal-image</init_from>
          </surface>
        </newparam>
        <newparam sid="Std_Tongue-normal-sampler">
          <sampler2D>
            <source>Std_Tongue-normal-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <phong>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="Std_Tongue-diffuse" texcoord="CHANNEL0" />
            </diffuse>
            <specular>
              <color sid="specular">0.0500000007   0.0500000007   0.0500000007   1</color>
            </specular>
            <shininess>
              <float sid="shininess">107.028641</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
            <bump>
              <texture texture="Std_Tongue-normal" texcoord="CHANNEL0" />
            </bump>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
