  <library_effects>
    <effect id="Teeth-effect">
      <profile_COMMON>
      <newparam sid="Image_17-surface">
        <surface type="2D"><init_from>Image_17</init_from></surface>
      </newparam>
      <newparam sid="Image_17-sampler">
        <sampler2D><source>Image_17-surface</source></sampler2D>
      </newparam>

        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="Image_17-sampler" texcoord="UVMap"/>
            </diffuse>
            <reflectivity>
